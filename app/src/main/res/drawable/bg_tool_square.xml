<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="1dp"/>
            <solid android:color="@color/invert_bg"/>
            <stroke android:width="1dp" android:color="@color/invert_bg"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="1dp"/>
            <solid android:color="@color/brand_soft"/>
            <stroke android:width="1dp" android:color="@color/ink_900"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="1dp"/>
            <solid android:color="@color/surface"/>
            <stroke android:width="1dp" android:color="@color/line"/>
        </shape>
    </item>
</selector>
