<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_row"
    android:padding="12dp">

    <ImageView
        android:id="@+id/recentIcon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_pi_file"
        android:background="@drawable/bg_badge_blue"
        android:padding="8dp"
        app:tint="@color/brand" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <TextView
            android:id="@+id/recentTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dokumen.docx"
            android:textColor="@color/ink_900"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/recentSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 KB · 01 Jan 2025"
            android:textColor="@color/ink_400"
            android:textSize="10sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <ImageView
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_pi_chevron_right"
        app:tint="@color/ink_400" />
</LinearLayout>
