<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <!-- SIDEBAR KIRI: rail kategori + panel tool -->
        <com.retrobit.office.ui.ToolSidebar
            android:id="@+id/toolSidebar"
            android:layout_width="wrap_content"
            android:layout_height="match_parent" />

        <!-- AREA KERJA -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Top bar ala terminal -->
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                style="@style/Widget.App.Toolbar"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:theme="@style/ThemeOverlay.Material3.Dark.ActionBar"
                app:title="WORD"
                app:titleTextColor="@color/invert_ink"
                app:titleTextAppearance="@style/TextAppearance.App.Title" />

            <!-- Strip alat tulis -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@color/panel"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp">

                <ImageButton
                    android:id="@+id/btnLanguage"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_pi_book_open"
                    android:background="@drawable/bg_circle"
                    android:padding="6dp"
                    app:tint="@color/ink_900"
                    android:tooltipText="Bahasa tulisan tangan"
                    android:contentDescription="Bahasa tulisan tangan" />

                <ImageButton
                    android:id="@+id/btnConvertNow"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="6dp"
                    android:src="@drawable/ic_pi_check"
                    android:background="@drawable/bg_circle"
                    android:padding="6dp"
                    app:tint="@color/ink_900"
                    android:tooltipText="Konversi tulisan ke teks"
                    android:contentDescription="Konversi tulisan ke teks" />

                <ImageButton
                    android:id="@+id/btnClearInk"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="6dp"
                    android:src="@drawable/ic_pi_trash"
                    android:background="@drawable/bg_circle"
                    android:padding="6dp"
                    app:tint="@color/ink_900"
                    android:tooltipText="Hapus tinta"
                    android:contentDescription="Hapus tinta" />

                <SeekBar
                    android:id="@+id/seekStrokeWidth"
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:max="20"
                    android:progress="6"
                    android:progressTint="@color/ink_900"
                    android:thumbTint="@color/ink_900" />

                <HorizontalScrollView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/colorPalette"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>

            <!-- Strip mode -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@color/surface"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp">

                <RadioGroup
                    android:id="@+id/modeToggle"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_segmented"
                    android:padding="2dp">

                    <RadioButton
                        android:id="@+id/modeHandwriting"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:button="@null"
                        android:background="@drawable/bg_segment_item"
                        android:gravity="center"
                        android:text="Tulis→Teks"
                        android:textSize="9sp"
                        android:fontFamily="monospace"
                        android:textColor="@color/seg_tint"
                        android:checked="true" />

                    <RadioButton
                        android:id="@+id/modeFreeDraw"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:button="@null"
                        android:background="@drawable/bg_segment_item"
                        android:gravity="center"
                        android:text="Gambar"
                        android:textSize="9sp"
                        android:fontFamily="monospace"
                        android:textColor="@color/seg_tint" />
                </RadioGroup>

                <ImageButton
                    android:id="@+id/btnPrint"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_pi_printer"
                    app:tint="@color/ink_900"
                    android:contentDescription="Cetak" />
            </LinearLayout>

            <!-- Dokumen -->
            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true"
                android:clipToPadding="false"
                android:paddingBottom="70dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="760dp">

                    <com.retrobit.office.word.WordEditorView
                        android:id="@+id/wordEditorView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/bg" />

                    <com.retrobit.office.core.stylus.HandwritingView
                        android:id="@+id/handwritingView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#141B1B18" />

                    <com.retrobit.office.core.stylus.FreeDrawView
                        android:id="@+id/freeDrawView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/candidateBar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="@color/surface"
                        android:padding="8dp"
                        android:visibility="gone"
                        android:layout_gravity="bottom" />
                </FrameLayout>
            </androidx.core.widget.NestedScrollView>

            <!-- Status strip -->
            <TextView
                android:id="@+id/stylusStatus"
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:background="@color/ink_900"
                android:gravity="center_vertical"
                android:paddingHorizontal="10dp"
                android:text="MODE: TULIS→TEKS | M-PENCIL READY"
                android:textSize="9sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:textColor="@color/invert_ink" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabSave"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="12dp"
        android:src="@drawable/ic_pi_save"
        app:tint="@color/invert_ink"
        app:backgroundTint="@color/ink_900"
        app:shapeAppearanceOverlay="@style/SquareFabShape"
        android:contentDescription="Simpan" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabShare"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="12dp"
        android:layout_marginStart="82dp"
        android:src="@drawable/ic_pi_share"
        app:fabSize="mini"
        app:tint="@color/ink_900"
        app:backgroundTint="@color/surface"
        app:shapeAppearanceOverlay="@style/SquareFabShape"
        android:contentDescription="Bagikan" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
