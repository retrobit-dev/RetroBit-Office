<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/surface"
            app:title="Word"
            app:titleTextColor="@color/ink_900"
            app:titleTextAppearance="@style/TextAppearance.App.Title" />

        <!-- Ribbon tabs -->
        <com.retrobit.office.word.WordToolbar
            android:id="@+id/wordToolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface" />

        <!-- Mode segmented -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/surface"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp">

            <RadioGroup
                android:id="@+id/modeToggle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:background="@drawable/bg_segmented"
                android:padding="3dp">

                <RadioButton
                    android:id="@+id/modeHandwriting"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:button="@null"
                    android:background="@drawable/bg_segment_item"
                    android:gravity="center"
                    android:text="  Tulis → Teks"
                    android:textSize="11sp"
                    android:textColor="@color/seg_tint"
                    android:drawableStart="@drawable/ic_pi_pencil"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/modeFreeDraw"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:button="@null"
                    android:background="@drawable/bg_segment_item"
                    android:gravity="center"
                    android:text="  Gambar Bebas"
                    android:textSize="11sp"
                    android:textColor="@color/seg_tint"
                    android:drawableStart="@drawable/ic_pi_brush" />
            </RadioGroup>

            <ImageButton
                android:id="@+id/btnPrint"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_pi_printer"
                app:tint="@color/ink_900"
                android:layout_marginStart="6dp"
                android:contentDescription="Cetak" />
        </LinearLayout>

        <!-- Handwriting controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/brand_soft"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLanguage"
                style="@style/Widget.App.Pill"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="ID"
                android:textStyle="bold"
                app:icon="@drawable/ic_pi_book_open" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConvertNow"
                style="@style/Widget.App.Pill"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:text="Konversi"
                app:icon="@drawable/ic_pi_check" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClearInk"
                style="@style/Widget.App.Pill"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:text="Hapus"
                app:icon="@drawable/ic_pi_trash" />

            <TextView
                android:id="@+id/stylusStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="Mode: Tulis → Teks"
                android:textSize="10sp"
                android:textColor="@color/brand"
                android:layout_marginStart="8dp" />

            <SeekBar
                android:id="@+id/seekStrokeWidth"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:max="20"
                android:progress="6"
                android:progressTint="@color/brand"
                android:thumbTint="@color/brand" />
        </LinearLayout>

        <!-- Color palette -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/colorPalette"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp" />
        </HorizontalScrollView>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Editor -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="90dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="800dp">

            <com.retrobit.office.word.WordEditorView
                android:id="@+id/wordEditorView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/bg" />

            <com.retrobit.office.core.stylus.HandwritingView
                android:id="@+id/handwritingView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#0A2E6BE6" />

            <com.retrobit.office.core.stylus.FreeDrawView
                android:id="@+id/freeDrawView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/candidateBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@color/surface"
                android:padding="8dp"
                android:elevation="8dp"
                android:visibility="gone"
                android:layout_gravity="bottom" />

            <!-- Ink tools -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="10dp">

                <ImageButton
                    android:id="@+id/btnPen"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:src="@drawable/ic_pi_pencil"
                    android:background="@drawable/bg_circle"
                    android:padding="10dp"
                    app:tint="@color/brand"
                    android:layout_marginBottom="8dp"
                    android:contentDescription="Pena" />

                <ImageButton
                    android:id="@+id/btnEraser"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:src="@drawable/ic_pi_eraser"
                    android:background="@drawable/bg_circle"
                    android:padding="10dp"
                    app:tint="@color/ink_900"
                    android:layout_marginBottom="8dp"
                    android:contentDescription="Penghapus" />

                <ImageButton
                    android:id="@+id/btnUndoInk"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:src="@drawable/ic_pi_undo"
                    android:background="@drawable/bg_circle"
                    android:padding="10dp"
                    app:tint="@color/ink_900"
                    android:layout_marginBottom="8dp"
                    android:contentDescription="Urungkan" />

                <ImageButton
                    android:id="@+id/btnClearFree"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:src="@drawable/ic_pi_trash"
                    android:background="@drawable/bg_circle"
                    android:padding="10dp"
                    app:tint="@color/danger"
                    android:contentDescription="Hapus semua" />
            </LinearLayout>
        </FrameLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabSave"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:src="@drawable/ic_pi_save"
        app:tint="@color/surface"
        app:backgroundTint="@color/brand"
        android:contentDescription="Simpan" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabShare"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="16dp"
        android:src="@drawable/ic_pi_share"
        app:fabSize="mini"
        app:tint="@color/ink_900"
        app:backgroundTint="@color/surface"
        android:contentDescription="Bagikan" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
