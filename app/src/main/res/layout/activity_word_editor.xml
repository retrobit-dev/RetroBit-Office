<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <!-- SIDEBAR KIRI: rail kategori + panel tool -->
        <com.retrobit.office.ui.ToolSidebar
            android:id="@+id/toolSidebar"
            android:layout_width="wrap_content"
            android:layout_height="match_parent" />

        <!-- AREA KERJA -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Top bar ala terminal -->
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                style="@style/Widget.App.Toolbar"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:theme="@style/ThemeOverlay.Material3.Dark.ActionBar"
                app:title="WORD"
                app:titleTextColor="@color/invert_ink"
                app:titleTextAppearance="@style/TextAppearance.App.Title" />

            <!-- Strip mode -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@color/surface"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp">

                <RadioGroup
                    android:id="@+id/modeToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_segmented"
                    android:padding="2dp">

                    <RadioButton
                        android:id="@+id/modeText"
                        android:layout_width="72dp"
                        android:layout_height="match_parent"
                        android:button="@null"
                        android:background="@drawable/bg_segment_item"
                        android:gravity="center"
                        android:text="KEYBOARD"
                        android:textSize="8sp"
                        android:fontFamily="monospace"
                        android:textColor="@color/seg_tint"
                        android:checked="true" />

                    <RadioButton
                        android:id="@+id/modeFreeDraw"
                        android:layout_width="72dp"
                        android:layout_height="match_parent"
                        android:button="@null"
                        android:background="@drawable/bg_segment_item"
                        android:gravity="center"
                        android:text="GAMBAR"
                        android:textSize="8sp"
                        android:fontFamily="monospace"
                        android:textColor="@color/seg_tint" />
                </RadioGroup>

                <TextView
                    android:id="@+id/modeHint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:fontFamily="monospace"
                    android:text="KETUK PARAGRAF → KETIK DI KEYBOARD"
                    android:textColor="@color/ink_400"
                    android:textSize="8sp"
                    android:maxLines="1" />

                <ImageButton
                    android:id="@+id/btnPrint"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_pi_printer"
                    app:tint="@color/ink_900"
                    android:contentDescription="Cetak" />
            </LinearLayout>

            <!-- Dokumen -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/docScroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true"
                android:clipToPadding="false">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="360dp">

                    <com.retrobit.office.word.WordEditorView
                        android:id="@+id/wordEditorView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/bg" />

                    <com.retrobit.office.core.stylus.FreeDrawView
                        android:id="@+id/freeDrawView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone" />
                </FrameLayout>
            </androidx.core.widget.NestedScrollView>

            <!-- Bar keyboard: selalu siap, tanpa mode tulisan tangan -->
            <LinearLayout
                android:id="@+id/inputBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@color/panel"
                android:paddingHorizontal="8dp"
                android:paddingVertical="5dp">

                <EditText
                    android:id="@+id/etInput"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip"
                    android:fontFamily="monospace"
                    android:gravity="center_vertical"
                    android:hint="Ketik teks paragraf…"
                    android:imeOptions="actionDone"
                    android:inputType="textCapSentences"
                    android:maxLines="1"
                    android:paddingHorizontal="10dp"
                    android:textColor="@color/ink_900"
                    android:textColorHint="@color/ink_400"
                    android:textSize="12sp" />

                <ImageButton
                    android:id="@+id/btnNewParagraph"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_tool_square"
                    android:padding="7dp"
                    android:src="@drawable/ic_pi_plus"
                    android:contentDescription="Paragraf baru"
                    android:tooltipText="Paragraf baru"
                    app:tint="@color/ink_900" />

                <ImageButton
                    android:id="@+id/btnKeyboard"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_tool_square"
                    android:padding="7dp"
                    android:src="@drawable/ic_pi_keyboard"
                    android:contentDescription="Buka keyboard"
                    android:tooltipText="Buka keyboard"
                    app:tint="@color/ink_900" />
            </LinearLayout>

            <!-- Status strip -->
            <TextView
                android:id="@+id/stylusStatus"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:background="@color/ink_900"
                android:gravity="center_vertical"
                android:paddingHorizontal="10dp"
                android:text="MODE: KEYBOARD | KETUK PARAGRAF UNTUK MENGEDIT"
                android:textSize="8sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:textColor="@color/invert_ink" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabSave"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="12dp"
        android:src="@drawable/ic_pi_save"
        app:tint="@color/invert_ink"
        app:backgroundTint="@color/ink_900"
        app:shapeAppearanceOverlay="@style/SquareFabShape"
        android:contentDescription="Simpan" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabShare"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="12dp"
        android:layout_marginStart="82dp"
        android:src="@drawable/ic_pi_share"
        app:fabSize="mini"
        app:tint="@color/ink_900"
        app:backgroundTint="@color/surface"
        app:shapeAppearanceOverlay="@style/SquareFabShape"
        android:contentDescription="Bagikan" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
