<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Excel - RetroBit Office" />

        <!-- Formula bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#F1F3F4"
            android:padding="8dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/cellRef"
                android:layout_width="60dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:background="#FFFFFF"
                android:text="A1"
                android:textStyle="bold"
                android:textSize="13sp" />

            <TextView
                android:layout_width="24dp"
                android:layout_height="wrap_content"
                android:text="fx"
                android:gravity="center"
                android:textStyle="italic"
                android:textColor="@color/excel_green"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/formulaBar"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="#FFFFFF"
                android:hint="Masukkan nilai atau rumus (=SUM)"
                android:padding="8dp"
                android:singleLine="true"
                android:imeOptions="actionDone"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCommitFormula"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="✓"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Excel Toolbar -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="6dp">

                <com.google.android.material.button.MaterialButton android:id="@+id/btnBold" android:layout_width="wrap_content" android:layout_height="32dp" android:text="B" style="@style/Widget.Material3.Button.OutlinedButton" android:textSize="12sp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnItalic" android:layout_width="wrap_content" android:layout_height="32dp" android:text="I" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_marginStart="4dp" android:textSize="12sp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnBgColor" android:layout_width="wrap_content" android:layout_height="32dp" android:text="🎨" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_marginStart="4dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnTextColor" android:layout_width="wrap_content" android:layout_height="32dp" android:text="A" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_marginStart="4dp" />
                <View android:layout_width="2dp" android:layout_height="24dp" android:background="#E0E0E0" android:layout_margin="8dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnAlignLeft" android:layout_width="wrap_content" android:layout_height="32dp" android:text="≡" style="@style/Widget.Material3.Button.OutlinedButton" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnAlignCenter" android:layout_width="wrap_content" android:layout_height="32dp" android:text="≡≡" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_marginStart="4dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnBorder" android:layout_width="wrap_content" android:layout_height="32dp" android:text="⊞" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_marginStart="4dp" />
                <View android:layout_width="2dp" android:layout_height="24dp" android:background="#E0E0E0" android:layout_margin="8dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnCurrency" android:layout_width="wrap_content" android:layout_height="32dp" android:text="Rp" style="@style/Widget.Material3.Button.OutlinedButton" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnPercent" android:layout_width="wrap_content" android:layout_height="32dp" android:text="%" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_marginStart="4dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnSum" android:layout_width="wrap_content" android:layout_height="32dp" android:text="Σ" style="@style/Widget.Material3.Button.TonalButton" android:layout_marginStart="4dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnChart" android:layout_width="wrap_content" android:layout_height="32dp" android:text="📊" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_marginStart="4dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnFilter" android:layout_width="wrap_content" android:layout_height="32dp" android:text="▼ Filter" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_marginStart="4dp" android:textSize="10sp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnPrintExcel" android:layout_width="wrap_content" android:layout_height="32dp" android:text="🖨" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_marginStart="4dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnSaveExcel" android:layout_width="wrap_content" android:layout_height="32dp" android:text="💾" style="@style/Widget.Material3.Button.TonalButton" android:layout_marginStart="4dp" />
            </LinearLayout>
        </HorizontalScrollView>

        <RadioGroup
            android:id="@+id/modeToggleExcel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#E8F0FE"
            android:padding="6dp">

            <RadioButton android:id="@+id/modeTouch" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="👆 Sentuh" android:checked="true" android:textSize="11sp" />
            <RadioButton android:id="@+id/modeStylusText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✍️ Tulis→Teks" android:textSize="11sp" android:layout_marginStart="12dp" />
            <RadioButton android:id="@+id/modeStylusDraw" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🎨 Gambar" android:textSize="11sp" android:layout_marginStart="12dp" />
        </RadioGroup>
    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <com.retrobit.office.excel.SpreadsheetView
            android:id="@+id/spreadsheetView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFFFFF" />

        <com.retrobit.office.core.stylus.HandwritingView
            android:id="@+id/handwritingOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:background="#0A1A73E8" />
    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
