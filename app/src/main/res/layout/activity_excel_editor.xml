<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/surface"
            app:title="Excel"
            app:titleTextColor="@color/ink_900"
            app:titleTextAppearance="@style/TextAppearance.App.Title" />

        <!-- Formula bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/surface"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp">

            <TextView
                android:id="@+id/cellRef"
                android:layout_width="52dp"
                android:layout_height="34dp"
                android:gravity="center"
                android:background="@drawable/bg_segmented"
                android:text="A1"
                android:textStyle="bold"
                android:textColor="@color/ink_900"
                android:textSize="12sp" />

            <TextView
                android:layout_width="22dp"
                android:layout_height="wrap_content"
                android:text="fx"
                android:gravity="center"
                android:textStyle="italic"
                android:textColor="@color/green"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/formulaBar"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:background="@drawable/bg_search"
                android:hint="Nilai atau rumus =SUM(...)"
                android:paddingHorizontal="10dp"
                android:singleLine="true"
                android:imeOptions="actionDone"
                android:textColor="@color/ink_900"
                android:textColorHint="@color/ink_400"
                android:textSize="12sp"
                android:importantForAutofill="no" />

            <ImageButton
                android:id="@+id/btnCommitFormula"
                android:layout_width="38dp"
                android:layout_height="34dp"
                android:layout_marginStart="6dp"
                android:src="@drawable/ic_pi_check"
                android:background="@drawable/bg_badge_green"
                android:padding="8dp"
                app:tint="@color/green"
                android:contentDescription="Terapkan" />
        </LinearLayout>

        <!-- Toolbar row 1: format -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:paddingBottom="4dp">

                <com.google.android.material.button.MaterialButton android:id="@+id/btnBold" style="@style/Widget.App.ToolButton" android:layout_width="wrap_content" android:layout_height="42dp" android:text="Tebal" app:icon="@drawable/ic_pi_bold" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnItalic" style="@style/Widget.App.ToolButton" android:layout_width="wrap_content" android:layout_height="42dp" android:text="Miring" app:icon="@drawable/ic_pi_italic" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnTextColor" style="@style/Widget.App.ToolButton" android:layout_width="wrap_content" android:layout_height="42dp" android:text="Warna" app:icon="@drawable/ic_pi_colors_swatch" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnBgColor" style="@style/Widget.App.ToolButton" android:layout_width="wrap_content" android:layout_height="42dp" android:text="Sel" app:icon="@drawable/ic_pi_frame" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnAlignLeft" style="@style/Widget.App.ToolButton" android:layout_width="wrap_content" android:layout_height="42dp" android:text="Kiri" app:icon="@drawable/ic_pi_text_align_left" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnAlignCenter" style="@style/Widget.App.ToolButton" android:layout_width="wrap_content" android:layout_height="42dp" android:text="Tengah" app:icon="@drawable/ic_pi_text_align_center" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnBorder" style="@style/Widget.App.ToolButton" android:layout_width="wrap_content" android:layout_height="42dp" android:text="Batas" app:icon="@drawable/ic_pi_table" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnCurrency" style="@style/Widget.App.ToolButton" android:layout_width="wrap_content" android:layout_height="42dp" android:text="Rp" app:icon="@drawable/ic_pi_money" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnPercent" style="@style/Widget.App.ToolButton" android:layout_width="wrap_content" android:layout_height="42dp" android:text="%" app:icon="@drawable/ic_pi_percent" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Toolbar row 2: data -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:paddingBottom="6dp">

                <com.google.android.material.button.MaterialButton android:id="@+id/btnSum" style="@style/Widget.App.ToolButton" android:layout_width="wrap_content" android:layout_height="42dp" android:text="Jumlah" app:icon="@drawable/ic_pi_sigma" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnChart" style="@style/Widget.App.ToolButton" android:layout_width="wrap_content" android:layout_height="42dp" android:text="Grafik" app:icon="@drawable/ic_pi_chart_bar_big" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnFilter" style="@style/Widget.App.ToolButton" android:layout_width="wrap_content" android:layout_height="42dp" android:text="Filter" app:icon="@drawable/ic_pi_filter" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnPrintExcel" style="@style/Widget.App.ToolButton" android:layout_width="wrap_content" android:layout_height="42dp" android:text="Cetak" app:icon="@drawable/ic_pi_printer" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnSaveExcel" style="@style/Widget.App.ToolButton" android:layout_width="wrap_content" android:layout_height="42dp" android:text="Simpan" app:icon="@drawable/ic_pi_save" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Mode segmented -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/brand_soft"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp">

            <RadioGroup
                android:id="@+id/modeToggleExcel"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_segmented"
                android:padding="3dp">

                <RadioButton
                    android:id="@+id/modeTouch"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:button="@null"
                    android:background="@drawable/bg_segment_item"
                    android:gravity="center"
                    android:text="Sentuh"
                    android:textSize="11sp"
                    android:textColor="@color/seg_tint"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/modeStylusText"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:button="@null"
                    android:background="@drawable/bg_segment_item"
                    android:gravity="center"
                    android:text="Tulis → Teks"
                    android:textSize="11sp"
                    android:textColor="@color/seg_tint" />

                <RadioButton
                    android:id="@+id/modeStylusDraw"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:button="@null"
                    android:background="@drawable/bg_segment_item"
                    android:gravity="center"
                    android:text="Gambar"
                    android:textSize="11sp"
                    android:textColor="@color/seg_tint" />
            </RadioGroup>
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <com.retrobit.office.excel.SpreadsheetView
            android:id="@+id/spreadsheetView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/surface" />

        <com.retrobit.office.core.stylus.HandwritingView
            android:id="@+id/handwritingOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:background="#0A2E6BE6" />
    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
