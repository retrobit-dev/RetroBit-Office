<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/bg">

    <!-- SIDEBAR KIRI -->
    <com.retrobit.office.ui.ToolSidebar
        android:id="@+id/toolSidebar"
        android:layout_width="wrap_content"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            style="@style/Widget.App.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:theme="@style/ThemeOverlay.Material3.Dark.ActionBar"
            app:title="EXCEL"
            app:titleTextColor="@color/invert_ink"
            app:titleTextAppearance="@style/TextAppearance.App.Title" />

        <!-- Formula bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/surface"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp">

            <TextView
                android:id="@+id/cellRef"
                android:layout_width="48dp"
                android:layout_height="30dp"
                android:gravity="center"
                android:background="@drawable/bg_segmented"
                android:text="A1"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:textColor="@color/ink_900"
                android:textSize="11sp" />

            <TextView
                android:layout_width="20dp"
                android:layout_height="wrap_content"
                android:text="fx"
                android:gravity="center"
                android:fontFamily="monospace"
                android:textColor="@color/ink_600"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/formulaBar"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:background="@drawable/bg_search"
                android:hint="nilai / =SUM(...)"
                android:paddingHorizontal="8dp"
                android:singleLine="true"
                android:imeOptions="actionDone"
                android:fontFamily="monospace"
                android:textColor="@color/ink_900"
                android:textColorHint="@color/ink_400"
                android:textSize="11sp"
                android:importantForAutofill="no" />

            <ImageButton
                android:id="@+id/btnCommitFormula"
                android:layout_width="34dp"
                android:layout_height="30dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_pi_check"
                android:background="@drawable/bg_badge_green"
                android:padding="7dp"
                app:tint="@color/ink_900"
                android:contentDescription="Terapkan" />
        </LinearLayout>

        <!-- Strip mode -->
        <RadioGroup
            android:id="@+id/modeToggleExcel"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_segmented"
            android:layout_marginHorizontal="8dp"
            android:layout_marginBottom="4dp"
            android:padding="2dp">

            <RadioButton
                android:id="@+id/modeTouch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:button="@null"
                android:background="@drawable/bg_segment_item"
                android:gravity="center"
                android:text="Sentuh"
                android:textSize="9sp"
                android:fontFamily="monospace"
                android:textColor="@color/seg_tint"
                android:checked="true" />

            <RadioButton
                android:id="@+id/modeStylusText"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:button="@null"
                android:background="@drawable/bg_segment_item"
                android:gravity="center"
                android:text="Tulis→Teks"
                android:textSize="9sp"
                android:fontFamily="monospace"
                android:textColor="@color/seg_tint" />

            <RadioButton
                android:id="@+id/modeStylusDraw"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:button="@null"
                android:background="@drawable/bg_segment_item"
                android:gravity="center"
                android:text="Gambar"
                android:textSize="9sp"
                android:fontFamily="monospace"
                android:textColor="@color/seg_tint" />
        </RadioGroup>

        <!-- Grid -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <com.retrobit.office.excel.SpreadsheetView
                android:id="@+id/spreadsheetView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/surface" />

            <com.retrobit.office.core.stylus.HandwritingView
                android:id="@+id/handwritingOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                android:background="#141B1B18" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
