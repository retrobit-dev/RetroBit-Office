<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

    <!-- SIDEBAR KIRI -->
    <com.retrobit.office.ui.ToolSidebar
        android:id="@+id/toolSidebar"
        android:layout_width="wrap_content"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            style="@style/Widget.App.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:theme="@style/ThemeOverlay.Material3.Dark.ActionBar"
            app:title="POWERPOINT"
            app:titleTextColor="@color/invert_ink"
            app:titleTextAppearance="@style/TextAppearance.App.Title" />

        <!-- Thumbnail strip -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/slideThumbnails"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:background="@color/panel"
            android:paddingHorizontal="8dp"
            android:paddingVertical="6dp" />

        <!-- Strip mode -->
        <RadioGroup
            android:id="@+id/modeTogglePpt"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_segmented"
            android:layout_marginHorizontal="8dp"
            android:layout_marginTop="4dp"
            android:padding="2dp">

            <RadioButton
                android:id="@+id/modeSelect"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:button="@null"
                android:background="@drawable/bg_segment_item"
                android:gravity="center"
                android:text="Pilih"
                android:textSize="9sp"
                android:fontFamily="monospace"
                android:textColor="@color/seg_tint"
                android:checked="true" />

            <RadioButton
                android:id="@+id/modeDraw"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:button="@null"
                android:background="@drawable/bg_segment_item"
                android:gravity="center"
                android:text="Gambar"
                android:textSize="9sp"
                android:fontFamily="monospace"
                android:textColor="@color/seg_tint" />


        </RadioGroup>

        <!-- Slide editor -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="10dp"
            android:clipToPadding="false">

            <com.retrobit.office.powerpoint.SlideEditorView
                android:id="@+id/slideEditorView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center" />

            <com.retrobit.office.core.stylus.FreeDrawView
                android:id="@+id/freeDrawOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Status strip: navigasi -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/ink_900"
            android:paddingHorizontal="6dp">

            <ImageButton
                android:id="@+id/btnPrev"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_pi_chevron_left"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/invert_ink"
                android:contentDescription="Sebelumnya" />

            <TextView
                android:id="@+id/slideIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1 / 1"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:textColor="@color/invert_ink"
                android:layout_marginHorizontal="6dp" />

            <ImageButton
                android:id="@+id/btnNext"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_pi_chevron_right"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/invert_ink"
                android:contentDescription="Berikutnya" />

            <TextView
                android:id="@+id/selectionInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="TIDAK ADA SELEKSI"
                android:textSize="8sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.06"
                android:textColor="@color/ink_400"
                android:layout_marginStart="8dp" />
        </LinearLayout>
    </LinearLayout>

    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabPlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="12dp"
        android:src="@drawable/ic_pi_play"
        app:tint="@color/invert_ink"
        app:backgroundTint="@color/ink_900"
        app:shapeAppearanceOverlay="@style/SquareFabShape"
        android:contentDescription="Slideshow" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabSavePpt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="12dp"
        android:layout_marginBottom="72dp"
        android:src="@drawable/ic_pi_save"
        app:fabSize="mini"
        app:tint="@color/ink_900"
        app:backgroundTint="@color/surface"
        app:shapeAppearanceOverlay="@style/SquareFabShape"
        android:contentDescription="Simpan" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
